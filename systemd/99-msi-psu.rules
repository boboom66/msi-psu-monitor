# MSI PSU USB HID interfaces.
# Grants access to the hidraw node so msi-psu-monitor works without root on
# desktop sessions (uaccess) and for plugdev members elsewhere.
#   808c = MPG Ai1600TS    aa6f = MPG Ai1300TS
#   56d4 = MEG Ai1300P     e749 = MEG Ai1000P     c9eb = MEG Ai1600T
# Keep this list in sync with MSIPSU.VARIANTS in protocol.py and with
# PSU_PRODUCT_IDS in scripts/install.sh.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0db0", ATTRS{idProduct}=="808c", MODE="0664", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0db0", ATTRS{idProduct}=="aa6f", MODE="0664", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0db0", ATTRS{idProduct}=="56d4", MODE="0664", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0db0", ATTRS{idProduct}=="e749", MODE="0664", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0db0", ATTRS{idProduct}=="c9eb", MODE="0664", GROUP="plugdev", TAG+="uaccess"
