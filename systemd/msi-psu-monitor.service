[Unit]
Description=MSI PSU Monitor daemon (GPU Safeguard+ per-pin current alerts)
Documentation=https://github.com/HesiPullupTimbo/msi-psu-monitor
Documentation=file:/usr/share/doc/msi-psu-monitor/README.md
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
# /usr/bin/env keeps the unit working for both /usr/bin (package) and
# /usr/local/bin (pip) installs of the console script.
# No --config: the file is optional and read from CONFIG_FILES, so the unit
# starts on a box where nobody installed one yet.
ExecStart=/usr/bin/env msi-psu-monitor-daemon
Restart=always
RestartSec=5
# systemd creates /var/lib/msi-psu-monitor (state.json + daily-*.log).
StateDirectory=msi-psu-monitor
User=root
Group=root

# The daemon holds /dev/hidraw* open for the whole runtime, so never set
# PrivateDevices=yes here. ProtectSystem=full still makes /usr, /boot and /etc
# read-only while leaving /var and /run writable for the state files.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Defence in depth that does not touch /dev/hidraw* or the StateDirectory.
# Deliberately no UMask=0077: state.json stays readable by the uaccess user, so
# a non-root dashboard can still read the totals it is meant to show.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
# The daemon has no network surface: it reads hidraw and writes files/journald.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
ProtectProc=invisible
ProcSubset=pid
PrivateIPC=yes
# Root is required for /dev/hidraw*, but no capability is: the device node is
# root-owned and the state directory is created by systemd. Do not re-add a
# capability just to "make root work" -- this is the least-privilege check.
CapabilityBoundingSet=

# Alerts are written to stderr, which journald records:
#   journalctl -u msi-psu-monitor -f

[Install]
WantedBy=multi-user.target
