# /etc/msi-psu-monitor.conf - example configuration.
#
# Precedence: CLI flags > this file > built-in defaults.
# The file is optional; without it every value below is already the default.
# Copy it with:  sudo install -m 644 docs/msi-psu-monitor.conf.example \
#                                /etc/msi-psu-monitor.conf

[monitor]
# Default output format: text | json | prometheus.
format = text
# Default polling interval for --watch, in seconds (--watch <n> overrides).
interval = 2
# Write output here instead of stdout (same as --output).
#output = /var/lib/node_exporter/msi-psu.prom
# Pick one PSU by serial number when several are attached (same as --serial).
#serial = 0123456789AB
# Diagnostics verbosity (same as --verbose / --quiet).
verbose = no
quiet = no
# Skip the E1h alert poll entirely (same as --no-alerts). Honoured by the CLI
# and by the daemon: with it on there is no Status line, no alert metric and no
# ALERT line at all -- which is not the same as "everything is normal".
no_alerts = no

[alerts]
# Consecutive polls that must report the same alert before it is raised.
# 2 keeps a single flaky 5-second average from paging; 1 makes it edge-only.
consecutive_required = 2

# Local early-warning limits (software, separate from the PSU's own E1h
# protection trip). A sample at or above a limit raises the matching alert,
# logs it like a hardware alert and makes --once exit 2. Set a limit to 0 to
# disable it. Initial values are REQ-14; tune after real-hardware acceptance.
# Unit of power_w: W; temp_c: degrees C; all currents: A.
power_w = 1200
temp_c = 70
# One 12V-2x6 pin (the PSU's own C0h factory point is 12 A).
pin_max_a = 12
# Spread between the six pins of one connector (C0h factory: 5 A).
pin_imbalance_a = 5
# Sum of the six pins of one 12V-2x6 connector (600 W / 12 V = 50 A).
connector_a = 50
# Combined rail currents (product-spec maximums).
rail_12v_a = 108.33
rail_5v_a = 22
rail_3v3_a = 22

[daemon]
# Directory for state.json and daily-YYYYMMDD.log.
# Default: /var/lib/msi-psu-monitor (systemd StateDirectory), otherwise
# $XDG_STATE_HOME/msi-psu-monitor. MSI_PSU_STATE_DIR overrides both.
#state_dir = /var/lib/msi-psu-monitor
# node_exporter textfile collector target. Unset disables the export.
#prom_path = /var/lib/node_exporter/msi-psu.prom
# Port for `msi-psu-monitor --dashboard` (loopback only).
port = 8899
# PSU polling cadence used for alert evaluation, in seconds.
sample_interval = 1
# How often the prometheus textfile is atomically replaced, in seconds.
prom_interval = 30
# How often a history line is appended and state.json is persisted, in seconds.
history_interval = 60
# Daily buckets and daily-*.log files older than this are pruned.
retention_days = 30
# Append alert edges/recoveries to alerts-YYYYMMDD.log in the state directory
# (rotated at 5 MiB, pruned with retention_days). The MSI Center equivalent is
# AlertLog_MM_dd_yyyy.log; set to no to keep alerts on stderr/journald only.
#alert_log = yes
# Write latest.json every sample for the dashboard's 1 s live charts.
# Set to no on a write-sensitive disk; the dashboard then updates per minute.
live_snapshot = yes

[fan]
# Re-assert a fan profile every time the daemon (re)opens the PSU, the way MSI
# Center does when it takes the device over. The PSU keeps 41h across a suspend
# but not across AC loss, so this is what makes a custom curve survive a power
# cut. Leave both `mode` and `zero_fan` commented out and the daemon never
# writes to the PSU.
#
#   auto        - hand the fan back to the PSU's own curve
#   performance - MSI PCIE5 Cooling Wizard's name for that same curve (alias)
#   customized  - hold a fixed duty
#
#mode = customized
#duty = 60
# Zero Fan switch to re-assert with the profile (43h + F1h). TS models only.
#zero_fan = on
